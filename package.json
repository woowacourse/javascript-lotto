{
  "name": "javascript-lotto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "jest --no-cache",
    "start-step1": "node src/step1-index.js",
    "start-step2": "vite",
    "deploy": "vite build --base=/javascript-lotto/ --minify=false && npx gh-pages -d dist"
  },
  "homepage": "https://bel1c10ud.github.io/javascript-lotto",
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "vite": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["@testing-library/jest-dom"],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/mocks/"
    ],
    "moduleNameMapper": {
      "\\.(png|svg|jpg|jpeg|gif)$": "<rootDir>/__tests__/mocks/fileMock.js"
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "engines": {
    "npm": ">=10.8.2",
    "node": ">=20.17.0"
  }
}
